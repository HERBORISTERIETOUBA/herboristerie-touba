// =========================================================
// HERBORISTERIE TOUBA — firestore.rules
// =========================================================
// كيفية التفعيل:
// 1. افتح Firebase Console → Firestore Database → Rules
// 2. الصق هذا المحتوى بالكامل مكان القواعد الحالية
// 3. اضغط "Publish"
//
// ⚠️ عدّل قائمة isAdmin() بالأسفل بإيميلك الحقيقي إن تغيّر.
// =========================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'babayarmohamedamine4@gmail.com'
        ];
    }

    // ---------- PRODUCTS ----------
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- DELIVERY_CITIES ----------
    match /delivery_cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- SITE_CONTENT ----------
    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- DISCOUNT_CODES (codes promo — V10) ----------
    // L'ID du document EST le code (toujours en MAJUSCULES). Un client ne
    // lit ou n'écrit JAMAIS cette collection directement : la vérification
    // ("Appliquer" dans le panier) passe par la Cloud Function en lecture
    // seule validateDiscountCode, et l'application réelle + le marquage
    // "utilisé" se font uniquement à l'intérieur de la transaction
    // createOrder (Admin SDK, contourne ces règles). Gestion (créer /
    // désactiver / supprimer) réservée à l'admin dans le dashboard.
    match /discount_codes/{code} {
      allow read, write: if isAdmin();
    }

    // ---------- ORDERS ----------
    // 🔴 SÉCURITÉ DES PRIX — les commandes ne sont PLUS créées
    // directement par le client depuis le navigateur (ni pour un seul
    // article, ni pour un panier multiple). Toute commande passe
    // désormais par la Cloud Function "createOrder" (functions/index.js),
    // qui tourne avec les droits Admin SDK et recalcule elle-même le
    // prix, le sous-total, les frais de livraison et le total à partir
    // des vraies données Firestore (jamais depuis ce que le client
    // envoie). L'Admin SDK contourne ces règles, donc "create" est
    // fermé ici : plus aucune écriture cliente directe n'est possible,
    // même en trafiquant DevTools.
    match /orders/{orderId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // ---------- ORDER_IDEMPOTENCY (anti double-commande) ----------
    // Écrit uniquement par la Cloud Function createOrder (Admin SDK).
    // Aucun accès client, dans aucun sens.
    match /order_idempotency/{key} {
      allow read, write: if false;
    }

    // ---------- DEMAND_SIGNALS (Touba AI) ----------
    match /demand_signals/{signalId} {
      // Créé uniquement par Touba AI via l'Admin SDK. Aucun navigateur
      // client ne doit pouvoir polluer les signaux commerciaux.
      allow create, read, update, delete: if isAdmin();
    }

    // ---------- ANALYTICS_DAILY (compteur de visites) ----------
    match /analytics_daily/{dateId} {
      // L'identifiant doit être une date ISO (YYYY-MM-DD), afin d'éviter
      // de créer arbitrairement des milliers de documents hors format.
      // Un navigateur ne peut ajouter qu'une seule visite à la fois.
      // Cela évite qu'un client écrive directement 1000000 visites.
      allow create: if dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.keys().hasOnly(['visits'])
                    && request.resource.data.visits == 1;
      allow update: if dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.keys().hasOnly(['visits'])
                    && resource.data.visits is int
                    && request.resource.data.visits is int
                    && request.resource.data.visits == resource.data.visits + 1
                    && request.resource.data.visits <= 1000000;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- SESSIONS (suivi visiteurs réel) ----------
    // Création : champs limités et typés (pas de données arbitraires).
    // Mise à jour : uniquement les compteurs d'activité, jamais les
    // champs d'origine (startedAt/source/referrer) une fois créés —
    // empêche un visiteur de "réécrire l'historique" de sa session.
    function validSessionId(id) {
      return id is string && id.size() >= 10 && id.size() <= 100
        && id.matches('^s_[A-Za-z0-9_]+$');
    }

    function isValidSessionCreate(data) {
      return data.keys().hasOnly(['startedAt','lastActivityAt','source','referrer','lang','pageViews','pages','searchCount'])
        && data.startedAt is timestamp
        && data.lastActivityAt is timestamp
        && data.lang is string && data.lang.size() <= 5
        && data.pageViews is int && data.pageViews == 1
        && data.pages is list && data.pages.size() >= 1 && data.pages.size() <= 100
        && data.searchCount is int && data.searchCount == 0
        && (!('source' in data) || (data.source is string && data.source.size() <= 100))
        && (!('referrer' in data) || (data.referrer is string && data.referrer.size() <= 500));
    }

    function isValidSessionUpdate(data) {
      return data.diff(resource.data).affectedKeys()
        .hasOnly(['lastActivityAt','pageViews','pages','searchCount'])
        && data.lastActivityAt is timestamp
        && data.pageViews is int
        && data.pageViews >= resource.data.pageViews
        && data.pageViews <= resource.data.pageViews + 1
        && data.searchCount is int
        && data.searchCount >= resource.data.searchCount
        && data.searchCount <= resource.data.searchCount + 1
        && data.pages is list
        && data.pages.size() >= resource.data.pages.size()
        && data.pages.size() <= 100
        && data.pages.hasAll(resource.data.pages);
    }

    match /sessions/{sessionId} {
      allow create: if validSessionId(sessionId) && isValidSessionCreate(request.resource.data);
      allow update: if validSessionId(sessionId) && isValidSessionUpdate(request.resource.data);
      allow read, delete: if isAdmin();
    }

    // ---------- SITE_SEARCHES (recherches réelles des visiteurs) ----------
    match /site_searches/{searchId} {
      allow create: if request.resource.data.keys().hasOnly(['query','sessionId','lang','resultCount','createdAt'])
                    && request.resource.data.query is string
                    && request.resource.data.query.size() > 0
                    && request.resource.data.query.size() <= 300
                    && validSessionId(request.resource.data.sessionId)
                    && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
                    && (!('lang' in request.resource.data) ||
                        (request.resource.data.lang is string && request.resource.data.lang.size() <= 5))
                    && request.resource.data.createdAt is timestamp
                    && (!('resultCount' in request.resource.data) ||
                        (request.resource.data.resultCount is int
                         && request.resource.data.resultCount >= 0
                         && request.resource.data.resultCount <= 100000));
      allow read, update, delete: if isAdmin();
    }

    // ---------- PRODUCT_EVENTS (analytics produit anonymisées — V10) ----------
    // Aucune donnée personnelle : juste quel produit, quel type d'action,
    // rattaché à un sessionId anonyme (le même que "sessions"), jamais à
    // un nom/téléphone/email. Sert à calculer vues/ajouts au panier par
    // produit dans le Dashboard (Section 39 du prompt).
    function isValidProductEvent(data) {
      return data.keys().hasOnly(['productId','type','sessionId','createdAt'])
        && data.productId is string && data.productId.size() > 0 && data.productId.size() <= 200
        && exists(/databases/$(database)/documents/products/$(data.productId))
        && data.type in ['view','add_to_cart']
        && validSessionId(data.sessionId)
        && exists(/databases/$(database)/documents/sessions/$(data.sessionId))
        && data.createdAt is timestamp;
    }
    match /product_events/{eventId} {
      allow create: if isValidProductEvent(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // ---------- AI_RATE_LIMITS (anti-abus Touba AI) ----------
    // Écrit uniquement par la Cloud Function toubaAiChat (Admin SDK).
    match /ai_rate_limits/{key} {
      allow read, write: if false;
    }

    // ---------- Tout le reste : refusé par défaut ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

